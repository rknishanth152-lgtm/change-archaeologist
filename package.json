{
  "name": "change-archaeologist",
  "version": "0.1.0",
  "description": "Local-first JavaScript and TypeScript Git-history analysis tool",
  "type": "module",
  "bin": {
    "change-archaeologist": "./bin/change-archaeologist.js"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:cli": "tsc --outDir dist",
    "build:viewer": "vite build",
    "build": "tsc --outDir dist && vite build",
    "dev": "vite",
    "preview": "vite preview",
    "demo": "npm run build && node dist/scripts/run-demo.js"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@xyflow/react": "^12.12.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.68.0",
    "monaco-editor": "^0.57.0",
    "motion": "^14.9.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "ts-morph": "^24.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.6.2",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.7.0",
    "vite": "^7.3.7",
    "vitest": "^3.0.0"
  }
}
