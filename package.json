{
  "name": "change-archaeologist",
  "version": "0.1.0",
  "description": "See how a function changed between two Git versions, and whether its tests moved with it. Local-first AST analysis for JavaScript and TypeScript.",
  "keywords": [
    "git",
    "ast",
    "static-analysis",
    "typescript",
    "javascript",
    "code-review",
    "testing",
    "cli",
    "local-first"
  ],
  "homepage": "https://github.com/rknishanth152-lgtm/change-archaeologist#readme",
  "bugs": {
    "url": "https://github.com/rknishanth152-lgtm/change-archaeologist/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rknishanth152-lgtm/change-archaeologist.git"
  },
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "change-archaeologist": "./bin/change-archaeologist.js"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:cli": "tsc --outDir dist",
    "build:viewer": "vite build",
    "build": "tsc --outDir dist && vite build",
    "dev": "vite",
    "preview": "vite preview",
    "demo": "npm run build && node dist/scripts/run-demo.js",
    "stress:report": "npm run build:cli && node dist/scripts/generate-dig-stress-report.js"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@monaco-editor/react": "^4.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.68.0",
    "monaco-editor": "^0.57.0",
    "motion": "^14.9.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-resizable-panels": "^4.21.0",
    "tailwind-merge": "^3.7.0",
    "ts-morph": "^24.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.7.0",
    "vite": "^7.3.7",
    "vitest": "^3.0.0"
  },
  "overrides": {
    "dompurify": "3.4.17"
  }
}
